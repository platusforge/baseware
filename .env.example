# ── Copy to .env ─────────────────────────────────────────────────────────
DB_USER=saas
DB_PASSWORD=change-me-strong-password
DB_NAME=saas

SERVER_PORT=3000
DATABASE_URL=postgresql://saas:change-me-strong-password@db:5432/saas

JWT_SECRET=change-me-min-32-chars-long-secret-please
# NEVER ship production with the placeholder above (it is public).
# Generate a real one: openssl rand -base64 48
JWT_ISSUER=saas-boilerplate
JWT_AUDIENCE=saas-boilerplate-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=
BCRYPT_COST=12

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3000
# Public base URL of the API (used to build OAuth callback URLs)
API_PUBLIC_URL=http://localhost:3000

# Stripe billing (per-org subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# OAuth (Google + GitHub) — leave empty to hide the buttons
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Transactional email (Resend HTTP API)
EMAIL_FROM=no-reply@example.com
RESEND_API_KEY=

# Storage (S3-compatible) — file uploads / avatars
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability (optional, graceful no-op when empty)
POSTHOG_KEY=
SENTRY_DSN=

ADMIN_EMAIL=admin@example.com
LOG_LEVEL=info
