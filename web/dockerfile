# ── Development: Vite HMR ────────────────────────────────────────────
# NOTE: built from the REPO ROOT (see docker-compose build.context).
FROM node:24-alpine AS development
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json ./web/
RUN npm ci --workspace=web
WORKDIR /app/web
EXPOSE 5173
CMD ["npm", "run", "dev", "--", "--host"]

# ── Build: compile static assets ─────────────────────────────────────
FROM node:24-alpine AS build-stage
WORKDIR /app
COPY package.json package-lock.json ./
COPY web/package.json ./web/
RUN npm ci --workspace=web
COPY web/. ./web/
WORKDIR /app/web
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# ── Production: serve via nginx ──────────────────────────────────────
FROM nginx:alpine AS production-stage
COPY --from=build-stage /app/web/dist /usr/share/nginx/html
COPY web/nginx.conf /etc/nginx/conf.d/default.conf.template
ENV SERVER_UPSTREAM=http://server:3000
EXPOSE 80
CMD ["/bin/sh", "-c", "envsubst '$SERVER_UPSTREAM' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
